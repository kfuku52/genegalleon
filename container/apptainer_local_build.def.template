Bootstrap: docker
From: mambaorg/micromamba:noble@sha256:a0a4da2d5315f0d5b9d98196f2e9ecf50152c750bed4023bb127baade7e8faca

%files
    @@STAGING_ROOT@@/env /opt/pg/env
    @@STAGING_ROOT@@/apt /opt/pg/apt
    @@STAGING_ROOT@@/spec /opt/pg/spec
    @@STAGING_ROOT@@/testdata /opt/pg/testdata
    @@STAGING_ROOT@@/scripts /opt/pg/scripts
    @@STAGING_ROOT@@/source_branches.env /opt/pg/source_branches.env
    @@STAGING_ROOT@@/treevis /opt/pg/src/genegalleon.treevis
    @@STAGING_ROOT@@/pip-compatibility.requirements.txt /opt/pg/pip-compatibility.requirements.txt

%environment
    export DEBIAN_FRONTEND=noninteractive
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/usr/local/bin:${PATH}
    export R_LIBS_SITE=/opt/conda/lib/R/library

%labels
    org.opencontainers.image.title GeneGalleon workflow container
    org.opencontainers.image.description Reproducible native Apptainer or Singularity runtime for GeneGalleon
    org.opencontainers.image.source https://github.com/kfuku52/genegalleon
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.created @@BUILD_DATE@@
    org.opencontainers.image.revision @@VCS_REF@@
    org.opencontainers.image.version @@GG_VERSION@@
    io.genegalleon.build-input @@BUILD_INPUT_HASH@@
    io.genegalleon.runtime-input @@RUNTIME_INPUT_HASH@@
    io.genegalleon.build-target @@BUILD_TARGET@@
    io.genegalleon.security-refresh-epoch @@SECURITY_REFRESH_EPOCH@@
    io.genegalleon.local_image_ref @@LOCAL_IMAGE_REF@@
    io.genegalleon.local_image_tag @@LOCAL_IMAGE_TAG@@

%post -c /bin/bash
    set -euo pipefail

    export DEBIAN_FRONTEND=noninteractive
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/usr/local/bin:${PATH}
    export R_LIBS_SITE=/opt/conda/lib/R/library

    target_arch="@@TARGET_ARCH@@"
    build_target="@@BUILD_TARGET@@"
    export GG_BUILD_JOBS="@@GG_BUILD_JOBS@@"
    security_refresh_epoch="@@SECURITY_REFRESH_EPOCH@@"
    notung_download_page="@@NOTUNG_DOWNLOAD_PAGE@@"
    notung_download_host_ip="@@NOTUNG_DOWNLOAD_HOST_IP@@"
    notung_zip_sha256="@@NOTUNG_ZIP_SHA256@@"
    kfu52_repo_ref="@@KFU52_REPO_REF@@"
    kfu52_amalgkit_auto_select_ref="@@KFU52_AMALGKIT_AUTO_SELECT_REF@@"
    kfu52_amalgkit_branch_candidates="@@KFU52_AMALGKIT_BRANCH_CANDIDATES@@"
    kfu52_amalgkit_repo_ref="@@KFU52_AMALGKIT_REPO_REF@@"
    kfu52_amalgkit_repo_sha="@@KFU52_AMALGKIT_REPO_SHA@@"
    kfu52_cdskit_repo_ref="@@KFU52_CDSKIT_REPO_REF@@"
    kfu52_cdskit_repo_sha="@@KFU52_CDSKIT_REPO_SHA@@"
    kfu52_csubst_repo_ref="@@KFU52_CSUBST_REPO_REF@@"
    kfu52_csubst_repo_sha="@@KFU52_CSUBST_REPO_SHA@@"
    kfu52_nwkit_repo_ref="@@KFU52_NWKIT_REPO_REF@@"
    kfu52_nwkit_repo_sha="@@KFU52_NWKIT_REPO_SHA@@"
    busco_repo_url="@@BUSCO_REPO_URL@@"
    busco_mirror_repo_url="@@BUSCO_MIRROR_REPO_URL@@"
    busco_repo_ref="@@BUSCO_REPO_REF@@"
    busco_repo_sha="@@BUSCO_REPO_SHA@@"
    paml_repo_url="@@PAML_REPO_URL@@"
    paml_repo_ref="@@PAML_REPO_REF@@"
    paml_repo_sha="@@PAML_REPO_SHA@@"
    kfl1ou_repo_url="@@KFL1OU_REPO_URL@@"
    kfl1ou_repo_ref="@@KFL1OU_REPO_REF@@"
    kfl1ou_repo_sha="@@KFL1OU_REPO_SHA@@"
    kffractbias_repo_url="@@KFFRACTBIAS_REPO_URL@@"
    kffractbias_repo_ref="@@KFFRACTBIAS_REPO_REF@@"
    kffractbias_repo_sha="@@KFFRACTBIAS_REPO_SHA@@"
    kftools_repo_url="@@KFTOOLS_REPO_URL@@"
    rkftools_repo_url="@@RKFTOOLS_REPO_URL@@"
    radte_repo_url="@@RADTE_REPO_URL@@"
    kftools_repo_ref_override="@@KFTOOLS_REPO_REF@@"
    rkftools_repo_ref_override="@@RKFTOOLS_REPO_REF@@"
    radte_repo_ref="@@RADTE_REPO_REF@@"
    kftools_repo_sha="@@KFTOOLS_REPO_SHA@@"
    rkftools_repo_sha="@@RKFTOOLS_REPO_SHA@@"
    radte_repo_sha="@@RADTE_REPO_SHA@@"
    testnh_tarball_sha256="@@TESTNH_TARBALL_SHA256@@"
    cafe5_tarball_sha256="@@CAFE5_TARBALL_SHA256@@"

    bash /opt/pg/scripts/install_system_packages.sh development

    chmod +x /opt/pg/scripts/*.sh

    export USE_DEFAULTS_CHANNEL=0 STRICT_CHANNEL_PRIORITY=1 MAMBA_NO_LOW_SPEED_LIMIT=1

    base_required="/opt/pg/env/base.required.txt"
    if [[ -f "/opt/pg/env/base.${target_arch}.required.txt" ]]; then
        base_required="/opt/pg/env/base.${target_arch}.required.txt"
    fi
    optional_file="/opt/pg/env/base.${target_arch}.optional.txt"
    if [[ ! -f "${optional_file}" ]]; then
        optional_file="/dev/null"
    fi
    reconciled_required="/tmp/pg.base.required.txt"
    sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' \
        "${base_required}" /opt/pg/env/base.r.required.txt | awk '!seen[$0]++' > "${reconciled_required}"

    # Resolve the complete Python/R environment once. The previous sequence
    # solved the base environment, added packages explicitly, then solved the
    # combined environment again.
    /opt/pg/scripts/install_env.sh base "${reconciled_required}" "${optional_file}" python=3.12
    /opt/pg/scripts/ensure_generax_stable.sh base
    micromamba run -n base pip install --no-cache-dir \
        -r /opt/pg/pip-compatibility.requirements.txt
    micromamba run -n base python -c "import ete4, genomepy, lxml, ortools, PIL"
    micromamba run -n base python -m pip check
    TESTNH_TARBALL_SHA256="${testnh_tarball_sha256}" \
    CAFE5_TARBALL_SHA256="${cafe5_tarball_sha256}" \
        /opt/pg/scripts/install_nonconda_fallbacks.sh cafe5 mapnh astral r-cran verify-r
    rm -f "${reconciled_required}"

    runtime_required="/opt/pg/spec/required_commands.tsv"
    if [[ -f "/opt/pg/spec/required_commands.${target_arch}.tsv" ]]; then
        runtime_required="/opt/pg/spec/required_commands.${target_arch}.tsv"
    fi
    runtime_optional="/opt/pg/spec/optional_commands.${target_arch}.tsv"
    if [[ ! -f "${runtime_optional}" ]]; then
        runtime_optional="/dev/null"
    fi

    artifact_root="$(mktemp -d)"
    # Native builds reuse the same artifact producers and installer as Docker.
    # Docker keeps its pip cache outside the image in a BuildKit cache mount.
    export PIP_NO_CACHE_DIR=1
    bash /opt/pg/scripts/build_source_artifact.sh python amalgkit \
        "https://github.com/kfuku52/amalgkit.git" "${kfu52_amalgkit_repo_sha:-${kfu52_amalgkit_repo_ref}}" \
        "${artifact_root}/amalgkit"
    bash /opt/pg/scripts/build_source_artifact.sh python cdskit \
        "https://github.com/kfuku52/cdskit.git" "${kfu52_cdskit_repo_sha:-${kfu52_cdskit_repo_ref}}" \
        "${artifact_root}/cdskit"
    bash /opt/pg/scripts/build_source_artifact.sh python csubst \
        "https://github.com/kfuku52/csubst.git" "${kfu52_csubst_repo_sha:-${kfu52_csubst_repo_ref}}" \
        "${artifact_root}/csubst"
    bash /opt/pg/scripts/build_source_artifact.sh python nwkit \
        "https://github.com/kfuku52/nwkit.git" "${kfu52_nwkit_repo_sha:-${kfu52_nwkit_repo_ref}}" \
        "${artifact_root}/nwkit"
    bash /opt/pg/scripts/build_source_artifact.sh python BUSCO \
        "${busco_repo_url}" "${busco_repo_sha:-${busco_repo_ref}}" \
        "${artifact_root}/BUSCO" "${busco_mirror_repo_url}"
    bash /opt/pg/scripts/build_source_artifact.sh paml paml \
        "${paml_repo_url}" "${paml_repo_sha:-${paml_repo_ref}}" \
        "${artifact_root}/paml"
    bash /opt/pg/scripts/build_source_artifact.sh r kfl1ou \
        "${kfl1ou_repo_url}" "${kfl1ou_repo_sha:-${kfl1ou_repo_ref}}" \
        "${artifact_root}/kfl1ou"
    bash /opt/pg/scripts/build_source_artifact.sh python kfFractBias \
        "${kffractbias_repo_url}" "${kffractbias_repo_sha:-${kffractbias_repo_ref}}" \
        "${artifact_root}/kfFractBias"
    bash /opt/pg/scripts/build_source_artifact.sh python kftools \
        "${kftools_repo_url}" "${kftools_repo_sha:-${kftools_repo_ref_override:-${kfu52_repo_ref}}}" \
        "${artifact_root}/kftools"
    bash /opt/pg/scripts/build_source_artifact.sh r rkftools \
        "${rkftools_repo_url}" "${rkftools_repo_sha:-${rkftools_repo_ref_override:-${kfu52_repo_ref}}}" \
        "${artifact_root}/rkftools"
    bash /opt/pg/scripts/build_source_artifact.sh radte RADTE \
        "${radte_repo_url}" "${radte_repo_sha:-${radte_repo_ref}}" \
        "${artifact_root}/RADTE"
    bash /opt/pg/scripts/install_source_artifacts.sh "${artifact_root}"
    rm -rf -- "${artifact_root}"
    /opt/pg/scripts/install_helvetica_compat_font.sh base
    micromamba run -n base R CMD INSTALL /opt/pg/src/genegalleon.treevis
    micromamba run -n base Rscript -e \
        "stopifnot(requireNamespace('genegalleon.treevis', quietly = TRUE))"
    printf '%s\n' "${security_refresh_epoch}" > /opt/pg/logs/security_refresh_epoch.txt

    mkdir -p /home /usr/local/db/Pfam_LE /usr/local/db/jaspar /opt/pg/logs /opt/conda/envs /workspace
    ln -sfn /opt/conda /opt/conda/envs/base
    cat > /home/.bashrc <<'EOF_BASHRC'
export MAMBA_ROOT_PREFIX=/opt/conda
eval "$(micromamba shell hook --shell bash)"
conda() { micromamba "$@"; }
export PATH=/usr/local/bin:${PATH}
EOF_BASHRC
    cp /home/.bashrc /root/.bashrc

    notung_url="$("/opt/pg/scripts/resolve_notung_latest.sh" "${notung_download_page}")"
    tmp_zip="$(mktemp /tmp/notung.XXXXXX.zip)"
    NOTUNG_DOWNLOAD_HOST_IP="${notung_download_host_ip}" /opt/pg/scripts/download_url_with_fallback.sh "${notung_url}" "${tmp_zip}"
    /opt/pg/scripts/verify_sha256.sh "${tmp_zip}" "${notung_zip_sha256}"
    python /opt/pg/scripts/extract_notung_jar.py \
        --archive "${tmp_zip}" \
        --destination /usr/local/bin/Notung.jar
    rm -f "${tmp_zip}"

    if [[ "${build_target}" == "runtime" ]]; then
        bash /opt/pg/scripts/install_system_packages.sh prune-development
    fi
    apt-get update
    apt-get upgrade --with-new-pkgs -y
    apt-get --simulate dist-upgrade > /tmp/gg-apt-upgrade-simulation.txt
    if awk '/^Inst / { found = 1 } END { exit found ? 0 : 1 }' /tmp/gg-apt-upgrade-simulation.txt; then
        echo "Upgradeable system packages remain after the security refresh." >&2
        exit 1
    fi
    rm -f /tmp/gg-apt-upgrade-simulation.txt
    apt-get clean
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

    /opt/pg/scripts/validate_runtime.sh \
        --required "${runtime_required}" \
        --optional "${runtime_optional}" \
        --report "/opt/pg/logs/runtime_validation_${target_arch}.tsv"
    micromamba run -n base python -m pip check
    micromamba clean -i -l -y

    bash /opt/pg/scripts/post_install_notes.sh "${target_arch}"

    env_file="${APPTAINER_ENVIRONMENT:-${SINGULARITY_ENVIRONMENT:-}}"
    if [[ -n "${env_file}" ]]; then
        {
            echo 'export DEBIAN_FRONTEND=noninteractive'
            echo 'export MAMBA_ROOT_PREFIX=/opt/conda'
            echo 'export PATH=/opt/conda/bin:/usr/local/bin:${PATH}'
            echo 'export R_LIBS_SITE=/opt/conda/lib/R/library'
        } >> "${env_file}"
    fi

%runscript
    exec bash "$@"
