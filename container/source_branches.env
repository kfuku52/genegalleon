# Default upstream program sources intentionally follow moving branches.
#
# Container build wrappers resolve each branch to one commit at build start so
# every platform in that single build uses the same source snapshot.  Those
# resolved commits are build metadata, not repository defaults: never add
# *_REPO_SHA values to this file.  A caller may still supply an explicit
# *_REPO_SHA for a one-off reproducibility or debugging build.
GG_SOURCE_AMALGKIT_REPO_REF=master
GG_SOURCE_CDSKIT_REPO_REF=master
GG_SOURCE_CSUBST_REPO_REF=master
GG_SOURCE_NWKIT_REPO_REF=master
GG_SOURCE_BUSCO_REPO_REF=master
GG_SOURCE_PAML_REPO_REF=master
GG_SOURCE_KFL1OU_REPO_REF=main
GG_SOURCE_KFFRACTBIAS_REPO_REF=master
GG_SOURCE_KFTOOLS_REPO_REF=master
GG_SOURCE_RKFTOOLS_REPO_REF=master
GG_SOURCE_RADTE_REPO_REF=master
