+# Conditional coefficient-covariance form of the diagonal-trait pBIC penalty.
+# mean.effect.scales maps optimum changes to the solver's mean displacements;
+# constrained fits already express their covariance in optimum coordinates.
+pbic_trait_penalty <- function(fit, y, mean.effect.scales=numeric()){
+    if(any(!is.finite(mean.effect.scales)) || any(mean.effect.scales <= 0)){
+        # At alpha=0 a shifted mean can be fitted, but its OU optimum is not
+        # identifiable. Do not turn a degenerate determinant into -Inf evidence.
+        return(Inf)
+    }
+    scaled.covariance <- fit$vcov * (fit$n - fit$d) /
+        (stats::var(as.numeric(y)) * fit$n)
+    ld <- determinant(scaled.covariance, logarithm=TRUE)
+    if(ld$sign <= 0 || !is.finite(as.numeric(ld$modulus))){
+        return(Inf)
+    }
+    log.determinant <- as.numeric(ld$modulus) -
+        2 * sum(log(mean.effect.scales))
+    # fit$p counts the actually estimated covariance parameters, including
+    # observation error and excluding alpha when its bounds are fixed.
+    (fit$p - fit$d) * log(fit$n) - log.determinant
+}
+
