#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime_runner="${repo_root}/workflow/tests/run_in_runtime.sh"

usage() {
  cat <<'EOF'
Usage: bash ./dev <command> [args...]

Commands:
  check smoke|fast|static|runtime       Run one focused test lane.
  check integration-download           Run provider/download integration tests.
  check integration-workflow           Run workflow integration tests.
  check full                            Run all Python and declared R checks.
  check r                               Run all declared R checks in the runtime.
  lint                                  Run host syntax, Ruff, and config checks.
  config-check                          Validate entrypoint config metadata.
  config-schema [json|markdown]         Print generated config documentation.
  version                               Print VERSION.
  bump major|minor|patch                Update VERSION using Semantic Versioning.
  build                                 Build local/genegalleon:dev with development tools.

Environment:
  GG_PYTEST_WORKERS=N                   Parallel workers for fast/integration/full checks (default: 2).
  GG_RUNTIME_FRESHNESS=daily|always|off Runtime/upstream freshness policy (default: daily).
  GG_RUNTIME_FRESHNESS_SCOPE=owned|all  Upstreams checked locally (default: owned).
  BUILD_TARGET=development|runtime     Target for dev build (default: development).
  GG_BUILD_JOBS=N                      Jobs per native Make/R build (default: 2).
EOF
}

pytest_workers="${GG_PYTEST_WORKERS:-2}"
if [[ ! "${pytest_workers}" =~ ^[1-9][0-9]*$ && "${pytest_workers}" != "auto" ]]; then
  echo "GG_PYTEST_WORKERS must be a positive integer or auto." >&2
  exit 2
fi

command_name="${1:-}"
if [[ -z "${command_name}" ]]; then
  usage >&2
  exit 2
fi
shift

case "${command_name}" in
  check)
    suite="${1:-fast}"
    if [[ $# -gt 0 ]]; then shift; fi
    exec bash "${runtime_runner}" python "${repo_root}/workflow/tests/run_checks.py" \
      "${suite}" --workers "${pytest_workers}" "$@"
    ;;
  lint)
    cd "${repo_root}"
    while IFS= read -r -d '' script; do
      bash -n "${script}"
    done < <(git ls-files -z '*.sh')
    bash -n dev
    ruff check workflow container/scripts
    python3 workflow/support/entrypoint_config_schema.py --check
    echo "Host static checks passed; runtime compatibility still requires container checks."
    ;;
  config-check)
    exec python "${repo_root}/workflow/support/entrypoint_config_schema.py" --check
    ;;
  config-schema)
    format="${1:-json}"
    exec python "${repo_root}/workflow/support/entrypoint_config_schema.py" --format "${format}"
    ;;
  version)
    sed -n '1p' "${repo_root}/VERSION"
    ;;
  bump)
    exec python "${repo_root}/workflow/support/bump_version.py" "${1:-}"
    ;;
  build)
    exec env BUILD_SIF=0 IMAGE_SOURCE=local IMAGE=local/genegalleon TAG=dev \
      BUILD_TARGET="${BUILD_TARGET:-development}" \
      bash "${repo_root}/gg_container_build_entrypoint.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: ${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
